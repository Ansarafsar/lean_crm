# LLM provider (OpenRouter). Leave blank to run without AI summaries -
# the app still works and shows a configuration message in the summary card.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
SQL_ECHO=0
